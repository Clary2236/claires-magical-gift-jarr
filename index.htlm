<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Claire's Magical Gift Jar</title>
<style>
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;background:transparent;overflow:hidden}body{font-family:Georgia,serif;color:#fff}
main{height:100%;min-height:500px;display:flex;align-items:center;justify-content:center;text-align:center}
.scene{width:min(96vw,700px);padding:20px;filter:drop-shadow(0 0 18px #9b55ff)}
.small{letter-spacing:.2em;text-transform:uppercase;color:#e6d7ff;font-size:14px}
h1{font-size:clamp(32px,6vw,54px);line-height:1.05;margin:8px;color:#fff;text-shadow:0 0 8px #ff7de5,0 0 22px #9460ff}
.jarwrap{position:relative;width:min(72vw,420px);height:min(56vh,390px);min-height:280px;margin:12px auto}
.jar{position:absolute;inset:25px 24px 5px;border:7px solid #d9ccff;border-top-width:13px;border-radius:22% 22% 17% 17%;overflow:hidden;background:linear-gradient(100deg,#fff5,#b78aff33,#6ddfff33,#fff4);box-shadow:inset 12px 0 24px #fff5,inset -12px 0 24px #8755ff66,0 0 25px #a76bff}
.jar:before{content:"";position:absolute;z-index:2;left:-5%;top:-18px;width:110%;height:34px;border:7px solid #eee3ff;border-radius:50%;background:#bda2ef}
.liquid{position:absolute;bottom:0;width:100%;height:36%;background:linear-gradient(#bb8aff,#765bff 60%,#65cfff);border-top:3px solid #f4dfff;box-shadow:0 0 18px #cf9dff}
.liquid:after{content:"";position:absolute;top:-12px;left:-10%;width:120%;height:25px;border-radius:50%;background:#dfc5ff99;animation:wave 3s ease-in-out infinite alternate}
@keyframes wave{to{transform:translate(12px,5px) scaleX(.94)}}
.bow{position:absolute;z-index:4;top:0;left:0;right:0;font-size:58px}.moon,.star{position:absolute;z-index:3;text-shadow:0 0 14px #fff}.moon{font-size:36px;color:#fff1a8}.m1{left:0;top:25%}.m2{right:0;top:34%}.star{font-size:22px;animation:twinkle 2s infinite alternate}.s1{left:8%;top:55%}.s2{right:8%;top:16%}.s3{left:18%;bottom:12%}.s4{right:18%;bottom:8%}@keyframes twinkle{to{opacity:.35;transform:scale(.65)}}
.cat{position:absolute;z-index:4;left:0;bottom:0;font-size:52px}.crystal{position:absolute;z-index:4;right:0;bottom:0;font-size:48px}
.counter{width:min(90%,460px);margin:8px auto;padding:12px 18px;border:2px solid #dec4ff;border-radius:18px;background:#211344dd;box-shadow:0 0 18px #a45cff99}.count{font:bold 29px Arial;text-shadow:0 0 10px #ff7de5}.track{height:13px;margin-top:9px;border-radius:99px;background:#100a28;border:1px solid #bfa1ff;overflow:hidden}.fill{height:100%;width:0;background:linear-gradient(90deg,#ff7de5,#9d68ff,#75d9ff)}.thanks{margin-top:9px;color:#ffe1ff;font-size:17px}
.note{position:fixed;bottom:5px;left:0;right:0;text-align:center;font:11px Arial;color:#ffffff80}
</style></head><body><main><section class="scene"><div class="small">✦ a little magic for every stream ✦</div><h1>Claire's Magical<br>Gift Jar</h1><div class="jarwrap"><span class="moon m1">☾</span><span class="moon m2">☽</span><span class="star s1">✦</span><span class="star s2">✧</span><span class="star s3">✦</span><span class="star s4">✧</span><div class="bow">🎀</div><div class="jar"><div class="liquid"></div></div><div class="cat">🐈‍⬛</div><div class="crystal">🔮</div></div><div class="counter"><div class="count">♡ 0 / 1000 ♡</div><div class="track"><div class="fill"></div></div><div class="thanks">Thank you for being part of the magic! ✨</div></div></section></main><div class="note">Decorative overlay preview • not connected to TikTok gift events</div></body></html>
